  m_TableData:
  - m_Id: 4836696064
    m_Localized: "Monty: Hello my \u2013 Dear Researcher! Apologies for the \u2014
      connection \u2013 not good in space. I wanted to inform you of something \u2013
      interesting \u2013 I documented earlier today!"
    m_Metadata:
      m_Items: []
  - m_Id: 197309112320
    m_Localized: "Monty: There\u2019s quite the \u2014 strange cloud formation forming
      in the Atlantic\u2014 My good friend Oki is \u2013 in charge \u2013 reporting
      the weather down in the Caribbean. But\u2014 I haven\u2019t heard anything
      from her about \u2013 this."
    m_Metadata:
      m_Items: []
  - m_Id: 240011321344
    m_Localized: "Monty: Now that \u2013 think about it. I haven\u2019t heard any
      reports \u2013 in the past couple of weeks\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 280557658112
    m_Localized: "Monty: Please, my friend \u2013 would you go down \u2013 to Puerto
      Rico and \u2014 figure out what\u2019s going on. \r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 325319270400
    m_Localized: "Monty: I\u2019m counting on you!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
